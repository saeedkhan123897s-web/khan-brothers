# Server
PORT=3000
HOST=localhost
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=motorcycle_erp

# JWT
JWT_SECRET=replace_with_a_private_random_value_at_least_32_characters
JWT_EXPIRES_IN=7d

# Production seed account (required only when NODE_ENV=production)
# SEED_ADMIN_EMAIL=owner@example.com
# SEED_ADMIN_PASSWORD=use_a_unique_password_at_least_16_characters
# SEED_ADMIN_NAME=ERP Owner
# SEED_ADMIN_PHONE=

# Business
BUSINESS_NAME=Khan Brothers
CURRENCY=PKR

# Supabase edition. Keep both secrets server-side.
SUPABASE_URL=
SUPABASE_KEY=
APP_PASSWORD_HASH=
APP_SESSION_SECRET=
BUSINESS_TIME_ZONE=Asia/Muscat

# Optional stable encryption key for the administrator authenticator. Set before enrollment.
APP_MFA_ENCRYPTION_KEY=
